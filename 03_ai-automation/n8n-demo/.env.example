# Copy to .env and fill in. .env is gitignored — never commit the real key.

# Your n8n instance, once the domain is attached (no trailing slash).
N8N_BASE_URL=https://n8n.your-domain.com

# n8n editor -> Settings -> n8n API -> Create an API key.
# This key can read everything in your instance. Treat it like a password.
N8N_API_KEY=<your-api-key>

# The path from your Webhook node, e.g. "summarize" for
# https://n8n.your-domain.com/webhook/summarize
N8N_WEBHOOK_PATH=summarize
